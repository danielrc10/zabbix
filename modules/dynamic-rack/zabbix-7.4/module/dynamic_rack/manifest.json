{
  "manifest_version": 2.0,
  "id": "dynamic_rack",
  "type": "widget",
  "name": "Rack dinâmico",
  "namespace": "DynamicRack",
  "version": "0.1.0",
  "author": "Daniel Carvalho",
  "description": "Rack visual com equipamentos, prateleiras, estados e indicadores dinâmicos.",
  "widget": {
    "js_class": "CWidgetDynamicRack",
    "size": {"width": 36, "height": 12},
    "in": {
      "groupids": {"type": "_hostgroupids"},
      "hostids": {"type": "_hostids"}
    },
    "out": [
      {"type": "_hostid"},
      {"type": "_hostids"},
      {"type": "_itemid"},
      {"type": "_itemids"}
    ]
  },
  "actions": {
    "widget.dynamic_rack.view": {"class": "WidgetView"},
    "widget.dynamic_rack.equipment.edit": {
      "class": "EquipmentEdit",
      "view": "equipment.edit",
      "layout": "layout.json"
    },
    "widget.dynamic_rack.indicator.edit": {
      "class": "IndicatorEdit",
      "view": "indicator.edit",
      "layout": "layout.json"
    }
  },
  "assets": {
    "css": ["widget.css"],
    "js": ["class.widget.js"]
  }
}
